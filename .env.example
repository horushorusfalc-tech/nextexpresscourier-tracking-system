# Required: from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed if you use the listed features
# VITE_HUGGING_FACE_API_KEY=   # Not used in frontend; set HUGGING_FACE_API_KEY in Supabase Edge Function secrets for ai-chat
# VITE_RESEND_API_KEY=   # Set RESEND_API_KEY in Supabase Edge Function secrets for send-email
# VITE_APP_URL=https://nextexpresscourier.com
# ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
